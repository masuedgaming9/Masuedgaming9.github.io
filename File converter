            for (let i = 0; i < input.files.length; i++) {
                const file = input.files[i];
                const imgData = await getBase64(file);
                if (i > 0) pdf.addPage();
                pdf.addImage(imgData, 'JPEG', 10, 10, 190, 0);
            }

            pdf.save("converted_documents.pdf");
        }

        // 2. Compress Image
        async function processCompress() {
            const input = document.getElementById('compress-input');
            const quality = parseFloat(document.getElementById('compress-level').value);
            if(!input.files.length) return alert("Select an image first!");

            const file = input.files[0];
            const imgData = await getBase64(file);

            const img = new Image();
            img.src = imgData;
            img.onload = () => {
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0);

                const compressed = canvas.toDataURL('image/jpeg', quality);
                const resDiv = document.getElementById('compress-result');
                resDiv.innerHTML = `
                    <a href="${compressed}" download="compressed_${file.name}" class="glow-button inline-block py-3 px-8 rounded-xl font-extrabold text-white">
                        DOWNLOAD COMPRESSED IMAGE 🔥
                    </a>
                `;
            };
        }

        // 3. Swap Format
        async function processFormatSwap() {
            const input = document.getElementById('format-input');
            const targetFormat = document.getElementById('format-target').value;
            if(!input.files.length) return alert("Select an image to swap format!");

            const file = input.files[0];
            const imgData = await getBase64(file);

            const img = new Image();
            img.src = imgData;
            img.onload = () => {
                const canvas = document.createElement('canvas');
                canvas.width = img.width;
                canvas.height = img.height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0);

                const newImg = canvas.toDataURL(targetFormat);
                const ext = targetFormat.split('/')[1];
                
                const a = document.createElement('a');
                a.href = newImg;
                a.download = `converted_file.${ext}`;
                a.click();
            };
        }

        // 4. Audio Processing (Convert/Extract to WAV)
        async function processAudioConvert() {
            const input = document.getElementById('audio-input');
            if(!input.files.length) return alert("Select an audio or video file!");

            const file = input.files[0];
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const arrayBuffer = await file.arrayBuffer();
            
            try {
                const audioBuffer = await audioCtx.decodeAudioData(arrayBuffer);
                const wavBlob = audioBufferToWav(audioBuffer);
                const url = URL.createObjectURL(wavBlob);

                const resDiv = document.getElementById('audio-result');
                resDiv.innerHTML = `
                    <a href="${url}" download="extracted_audio.wav" class="glow-button inline-block py-3 px-8 rounded-xl font-extrabold text-white">
                        DOWNLOAD .WAV AUDIO 🎵
                    </a>
                `;
            } catch(e) {
                alert("Couldn't process audio file format!");
            }
        }

        // 5. PDF Merge
        async function processPdfMerge() {
            const input = document.getElementById('pdfmerge-input');
            if(input.files.length < 2) return alert("Select at least 2 PDF files to merge!");

            const mergedPdf = await PDFLib.PDFDocument.create();

            for (let file of input.files) {
                const bytes = await file.arrayBuffer();
                const pdf = await PDFLib.PDFDocument.load(bytes);
                const copiedPages = await mergedPdf.copyPages(pdf, pdf.getPageIndices());
                copiedPages.forEach(page => mergedPdf.addPage(page));
            }

            const mergedBytes = await mergedPdf.save();
            const blob = new Blob([mergedBytes], { type: 'application/pdf' });
            const url = URL.createObjectURL(blob);

            const a = document.createElement('a');
            a.href = url;
            a.download = 'merged_document.pdf';
            a.click();
        }

        // 6. Text Exporter
        function exportText(format) {
            const content = document.getElementById('text-input').value;
            if(!content.trim()) return alert("Write or paste some text first!");

            let mime = "text/plain";
            let ext = "txt";
            let finalContent = content;

            if(format === 'html') {
                mime = "text/html";
                ext = "html";
                finalContent = `<!DOCTYPE html><html><body><pre>${content}</pre></body></html>`;
            } else if(format === 'json') {
                mime = "application/json";
                ext = "json";
                finalContent = JSON.stringify({ content: content, timestamp: new Date() }, null, 2);
            }

            const blob = new Blob([finalContent], { type: mime });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `exported_text.${ext}`;
            a.click();
        }

        // Helpers
        function getBase64(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = () => resolve(reader.result);
                reader.onerror = error => reject(error);
            });
        }

        function audioBufferToWav(buffer) {
            let numOfChan = buffer.numberOfChannels,
                length = buffer.length * numOfChan * 2 + 44,
                out = new DataView(new ArrayBuffer(length)),
                channels = [], i, sample,
                offset = 0,
                pos = 0;

            function setUint16(data) { out.setUint16(pos, data, true); pos += 2; }
            function setUint32(data) { out.setUint32(pos, data, true); pos += 4; }

            setUint32(0x46464952); setUint32(length - 8); setUint32(0x45564157);
            setUint32(0x20746d66); setUint32(16); setUint16(1); setUint16(numOfChan);
            setUint32(buffer.sampleRate); setUint32(buffer.sampleRate * 2 * numOfChan);
            setUint16(numOfChan * 2); setUint16(16); setUint32(0x61746164); setUint32(length - pos - 4);

            for (i = 0; i < buffer.numberOfChannels; i++) channels.push(buffer.getChannelData(i));

            while (pos < length) {
                for (i = 0; i < numOfChan; i++) {
                    sample = Math.max(-1, Math.min(1, channels[i][offset]));
                    sample = (0.5 + sample < 0 ? sample * 32768 : sample * 32767) | 0;
                    out.setInt16(pos, sample, true); pos += 2;
                }
                offset++;
            }
            return new Blob([out], { type: "audio/wav" });
        }
    </script>
